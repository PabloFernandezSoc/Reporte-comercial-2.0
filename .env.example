# Copia este archivo a .env.local y completa. .env.local NO se sube a GitHub.

# --- API Bit ERP ---------------------------------------------------------
ERP_URL=https://biterp.cl:451/api/misservicios/reporte/prod-general
ERP_API_KEY=
# Rango que se pide al ERP (historia para detectar fluctuaciones: ideal 24+ meses)
ERP_DESDE=2025-01-01
ERP_HASTA=2026-12-31
# Si el certificado del ERP no es válido para Node, pon 1 (solo en red interna)
ERP_INSECURE_TLS=0
# Mapeo manual de campos (opcional). Ej: {"cliente":"NombreCliente","venta":"TotalVenta"}
ERP_FIELD_MAP=

# --- Metas ---------------------------------------------------------------
# Ruta a un JSON privado con las metas (formato de data/demo/metas.json).
# Por defecto se busca data/private/metas.json (ignorado por git).
METAS_PATH=

# --- Correo (opcional) ---------------------------------------------------
# Sin esto, "Enviar correo" abre tu cliente de correo con el borrador listo.
RESEND_API_KEY=
EMAIL_FROM=Comercial LYD <comercial@tudominio.cl>

# Forzar datos demo aunque haya API key
DEMO=0
